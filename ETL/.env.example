# SUPABASE CONFIGURATION
# Get Service Role Key from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here

# DATABASE CONNECTION
# Format: postgresql://user:password@host:port/database
# Get from Supabase Connection Pooler in Project Settings
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# GEMINI AI CONFIGURATION
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace all "your_*_here" values with actual credentials
# 3. NEVER commit .env - it's in .gitignore
# 4. This file is for LOCAL DEVELOPMENT ONLY
# 5. For production ETL, use environment variables in your deployment platform
