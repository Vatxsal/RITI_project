# SUPABASE CONFIGURATION
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# GEMINI AI CONFIGURATION
# Get API key from: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_MODEL=gemini-3-flash-preview

# BACKEND CONFIGURATION (for API routes only)
# Get Service Role Key from: https://supabase.com → Project Settings → API
# ⚠️ KEEP THIS SECRET - Never expose in frontend code
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all "your_*_here" values with actual credentials
# 3. NEVER commit .env.local - it's in .gitignore
# 4. For Vercel deployment, add these to Project Settings → Environment Variables
